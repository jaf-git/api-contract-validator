<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.jafgit.apicontractvalidator</id>
    <name>api-contract-validator</name>
    <vendor>jaf-git</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Register the notification group -->
        <notificationGroup id="ApiContractValidator" displayType="BALLOON" />

        <!-- Register the project service that will hold the cached spec -->
        <projectService
                serviceImplementation="com.github.jafgit.apicontractvalidator.services.OpenApiSpecService"/>

        <!-- Register the startup activity to load the spec in the background -->
        <backgroundPostStartupActivity
                implementation="com.github.jafgit.apicontractvalidator.startup.SpecLoaderActivity"/>

        <!-- Register our new API Drift Inspection -->
        <localInspection
                language="JAVA"
                groupName="API Contract Validator"
                displayName="API Contract Validation"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="com.github.jafgit.apicontractvalidator.inspection.ApiDriftInspection"/>

        <!-- Register the API Contract Tool Window -->
        <toolWindow
                id="API Contract"
                anchor="right"
                factoryClass="com.github.jafgit.apicontractvalidator.toolpanel.ApiToolWindowFactory"/>

    </extensions>
</idea-plugin>
